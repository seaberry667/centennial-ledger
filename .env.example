# Copy to .env for local runs (or set these in the Render dashboard).
PORT=3000
SITE_URL=https://centennialledger.com

# Postgres connection string. Leave unset to use the local JSON file store
# (data/db.json) for development and testing.
DATABASE_URL=

# Shared secret the Muse newsroom sends in the x-ingest-secret header
# when uploading new stories to POST /api/ingest.
INGEST_SECRET=change-me

# Google AdSense publisher ID (e.g. ca-pub-1234567890123456).
# Leave unset to render plain "Advertisement" placeholder slots.
ADSENSE_PUBLISHER_ID=

# ---------------- Newsletter (free email subscriptions) ----------------
# Signing secret for subscriber links (confirmation, preferences,
# unsubscribe). Falls back to INGEST_SECRET when unset.
SUBSCRIBE_SIGNING_SECRET=

# Secret that gates the internal dashboard at /admin/newsletter.
# When unset, the admin routes return 404.
NEWSLETTER_ADMIN_SECRET=

# Weekday send time for the Daily Brief draft, America/Denver, 24h.
NEWSLETTER_SEND_TIME=06:00

# Set to 1 to send the Daily Brief (and digests) automatically at
# the send time. Only takes effect when Amazon SES is configured;
# otherwise drafts wait for admin approval.
NEWSLETTER_AUTOSEND=

# Address that receives test sends from the admin dashboard.
NEWSLETTER_TEST_EMAIL=

# Postal address printed in newsletter footers (CAN-SPAM). A
# placeholder prints until this is set.
NEWSLETTER_POSTAL_ADDRESS=

# Amazon SES. All four must be set for live sending; until then,
# every send is written to the email_outbox table instead.
SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEWSLETTER_FROM=
