# Copy to .env for local runs (or set these in the Render dashboard).
PORT=3000
SITE_URL=https://centennialledger.com

# Postgres connection string. Leave unset to use the local JSON file store
# (data/db.json) for development and testing.
DATABASE_URL=

# Shared secret the Muse newsroom sends in the x-ingest-secret header
# when uploading new stories to POST /api/ingest.
INGEST_SECRET=change-me

# Google AdSense publisher ID (e.g. ca-pub-1234567890123456).
# Leave unset to render plain "Advertisement" placeholder slots.
ADSENSE_PUBLISHER_ID=
